# ── Zepòl — Headers sekirite (Apache / LWS) ──────────────────────────────────
# Ekivalan headers ki te nan firebase.json (firebase.json pa travay sou LWS).

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), payment=(), usb=()"

  # CSP — vèsyon pèmisif pou pa kraze Google Translate / Firebase / Font Awesome.
  # Li toujou bloke: plugins (object-src), base-tag injection, clickjacking
  # (frame-ancestors), ak resous http (mixed content). Pwoteksyon XSS prensipal
  # la se nan kòd la (escapeHtml).
  Header always set Content-Security-Policy "default-src 'self' https: data: blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' https: wss:; frame-src 'self' https:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
</IfModule>

# ── Pa janm sèvi fichye sansib ────────────────────────────────────────────────
<FilesMatch "(^\.|\.env|serviceAccountKey\.json|firebase\.json|\.firebaserc|firestore\.rules)$">
  Require all denied
</FilesMatch>

# ── Cache pou JS/CSS (vitès) ──────────────────────────────────────────────────
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  <FilesMatch "sw\.js$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
